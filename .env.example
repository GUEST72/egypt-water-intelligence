# Copy to .env to override. Every value below is also the built-in default in docker-compose.yml,
# so the stack starts without a .env file. Local development credentials only.

# MinIO (console http://localhost:9001)
MINIO_ACCESS_KEY=wateradmin
MINIO_SECRET_KEY=wateradminsecret
MINIO_RAW_BUCKET=water-raw
MINIO_RESTRICTED_BUCKET=water-restricted
MINIO_EVENT_BUCKET=water-events
MINIO_WAREHOUSE_BUCKET=water-warehouse

# Iceberg JDBC catalog database (Postgres, internal only)
CATALOG_DB_PASSWORD=iceberg-local

# Grafana live board (http://localhost:3001): admin login, and the read-only role on schema `live`
GRAFANA_ADMIN_PASSWORD=wateradmin
GRAFANA_DB_PASSWORD=grafana-live
