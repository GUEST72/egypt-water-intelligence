# Local development defaults. Copy to .env; do not commit .env.
COMPOSE_PROJECT_NAME=egypt-water-intelligence
MINIO_ACCESS_KEY=wateradmin
MINIO_SECRET_KEY=wateradminsecret
MINIO_RAW_BUCKET=water-raw
MINIO_RESTRICTED_BUCKET=water-restricted
MINIO_EVENT_BUCKET=water-events
# Keep warehouse bucket/path in sync with infrastructure/trino/catalog/water.properties.
MINIO_WAREHOUSE_BUCKET=water-warehouse
CATALOG_DB_PASSWORD=iceberglocal
AIRFLOW_DB_PASSWORD=airflowlocal
AIRFLOW_ADMIN_USERNAME=amr
AIRFLOW_ADMIN_PASSWORD=waterlocal
AIRFLOW_UID=50000
# Linux: set to `stat -c %g /var/run/docker.sock`. Docker Desktop usually uses 0.
DOCKER_GID=0
